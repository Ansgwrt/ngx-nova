# site_type: redirect

server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 {{.TargetURL}}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{.Domain}};

    {{if .ACME}}acme_certificate letsencrypt;
    ssl_certificate     $acme_certificate;
    ssl_certificate_key $acme_certificate_key;
    ssl_certificate_cache max=2;{{else}}# 本机 nginx 未编译 ACME 模块，请把证书放到 {{.SSLDir}}/{{.Domain}}.crt 与 {{.SSLDir}}/{{.Domain}}.key
    ssl_certificate     {{.SSLDir}}/{{.Domain}}.crt;
    ssl_certificate_key {{.SSLDir}}/{{.Domain}}.key;{{end}}

{{.TLSHardening}}

    location / {
        return 301 {{.TargetURL}}$request_uri;
    }
}
